#!/bin/sh
set -u

target_volume="${3:-/}"
if [ "$target_volume" != "/" ]; then
    exit 0
fi
app="/Applications/EPS Finder.app"
if ! /usr/bin/codesign --verify --deep --strict "$app"; then
    echo "EPS Finder: installed app failed integrity verification." >&2
    exit 1
fi
console_uid=$(/usr/bin/stat -f '%u' /dev/console)
if [ "$console_uid" -lt 500 ]; then
    exit 0
fi
console_user=$(/usr/bin/id -nu "$console_uid") || exit 0

run_for_user() {
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "$console_user" "$@"
}

if ! run_for_user /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"; then
    echo "EPS Finder: open the application once to register Quick Look extensions." >&2
    exit 0
fi
for name in Preview Thumbnail; do
    identifier=$(printf '%s' "$name" | /usr/bin/tr '[:upper:]' '[:lower:]')
    if ! run_for_user /usr/bin/pluginkit -a "$app/Contents/PlugIns/$name.appex" ||
       ! run_for_user /usr/bin/pluginkit -e use -i "local.epsfinder.$identifier"; then
        echo "EPS Finder: enable Quick Look extensions in System Settings if previews are unavailable." >&2
    fi
done
exit 0
